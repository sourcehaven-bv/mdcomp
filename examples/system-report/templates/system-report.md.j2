---
# Defaults
thresholds:
  disk_warning: 80
  disk_critical: 90
sections:
  system_info: true
  disk_usage: true
  network: true
  git_repos: true
  docker: true
  processes: true
content_base: .
---
# {{ report.title | default("System Status Report") }}

**Generated:** {{ shell("date '+%Y-%m-%d %H:%M:%S %Z'") | trim }}
**Hostname:** {{ shell("hostname") | trim }}
**User:** {{ shell("whoami") | trim }}

